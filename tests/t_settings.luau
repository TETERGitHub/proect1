--!nonstrict
local import = ...
local T = import("tests/Framework")
local Settings = import("core/Settings")
local Search = import("core/Search")
local Recents = import("core/Recents")
local Actions = import("core/Actions")

T.suite("Settings")
T.test("defaults match schema", "every key readable and equal to default", function()
	T.fresh()
	local n = 0
	for _, key in ipairs(Settings.keys({ includeHidden = true })) do
		T.truthy(Settings.isDefault(key), key); n += 1
	end
	return n .. " settings"
end)
T.test("number clamp and step", "out-of-range clamped, stepped", function()
	T.fresh()
	Settings.set("ui.scale", 99); T.eq(Settings.get("ui.scale"), 1.5)
	Settings.set("ui.scale", 0.01); T.eq(Settings.get("ui.scale"), 0.7)
	Settings.set("ui.scale", 1.07); T.eq(Settings.get("ui.scale"), 1.05)
	Settings.set("crosshair.size", 10.4); T.eq(Settings.get("crosshair.size"), 10)
end)
T.test("type validation rejects bad values", "set returns false, value unchanged", function()
	T.fresh()
	local cases = { { "ui.compact", "yes" }, { "ui.theme", "Nope" }, { "ui.scale", "x" }, { "ui.scale", 0 / 0 }, { "ui.accent", { r = 1 } },
		{ "ui.accent", "red" }, { "state.favorites", { 1 } }, { "state.page", 5 }, { "ui.language", "de" } }
	for _, c in ipairs(cases) do
		local ok = Settings.set(c[1], c[2])
		T.falsy(ok, c[1])
	end
	T.truthy(Settings.isDefault("ui.theme"))
end)
T.test("color normalised", "channels clamped and rounded", function()
	T.fresh()
	Settings.set("ui.accent", { r = 300, g = -5, b = 10.6 })
	local c = Settings.get("ui.accent")
	T.eq(c.r, 255); T.eq(c.g, 0); T.eq(c.b, 11)
end)
T.test("unknown key", "set false, get throws", function()
	T.fresh()
	T.falsy(Settings.set("nope.key", 1)); T.throws(function() Settings.get("nope.key") end, "unknown setting")
end)
T.test("change events", "Changed + observe fire once per real change", function()
	T.fresh()
	local a, b = 0, 0
	Settings.Changed:Connect(function() a += 1 end)
	Settings.observe("ui.theme", function() b += 1 end)
	Settings.set("ui.theme", "Ocean"); Settings.set("ui.theme", "Ocean"); Settings.set("ui.theme", "Rose")
	T.eq(a, 2); T.eq(b, 2)
end)
T.test("observe callNow", "initial callback", function()
	T.fresh()
	local seen
	Settings.observe("ui.theme", function(v) seen = v end, true)
	T.eq(seen, "iOS")
end)
T.test("reset key/category/module/all", "defaults restored at each scope", function()
	T.fresh()
	Settings.set("crosshair.size", 20); Settings.set("crosshair.enabled", true); Settings.set("ui.theme", "Rose")
	T.eq(Settings.resetCategory("crosshair"), 2); T.truthy(Settings.isDefault("crosshair.size"))
	T.eq(Settings.get("ui.theme"), "Rose")
	Settings.set("lighting.blurEnabled", true)
	T.eq(Settings.resetModule("Lighting"), 1)
	T.eq(Settings.resetAll() >= 1, true); T.truthy(Settings.isDefault("ui.theme"))
end)
T.test("resetAll leaves UI state alone", "state scope untouched", function()
	T.fresh()
	Settings.set("state.width", 900); Settings.set("ui.theme", "Rose")
	Settings.resetAll()
	T.eq(Settings.get("state.width"), 900)
end)
T.test("snapshot excludes state scope", "profile keys only", function()
	T.fresh()
	local snap = Settings.snapshot("profile")
	T.eq(snap["state.width"], nil); T.truthy(snap["ui.theme"] ~= nil)
end)
T.test("snapshot is a copy", "mutating copy leaves store intact", function()
	T.fresh()
	local snap = Settings.snapshot()
	snap["ui.accent"].r = 1
	T.eq(Settings.get("ui.accent").r, 110)
end)
T.test("validateMap reports rejects/unknown", "report lists each problem", function()
	T.fresh()
	local acc, rep = Settings.validateMap({ ["ui.theme"] = "Rose", ["ui.scale"] = "bad", ["zzz.q"] = 1, ["state.width"] = 700 })
	T.eq(acc["ui.theme"], "Rose"); T.eq(#rep.rejected, 1); T.eq(rep.rejected[1].key, "ui.scale")
	T.eq(#rep.unknown, 2)
end)
T.test("applyMap resetMissing", "missing keys return to default", function()
	T.fresh()
	Settings.set("crosshair.size", 30)
	Settings.applyMap({ ["ui.theme"] = "Ocean" }, "profile", "test", true)
	T.eq(Settings.get("ui.theme"), "Ocean"); T.eq(Settings.get("crosshair.size"), 10)
end)
T.test("history ring", "records old/new/source, capped at 100", function()
	T.fresh()
	for i = 1, 130 do Settings.set("crosshair.size", 2 + (i % 40), "t") end
	local h = Settings.history()
	T.eq(#h, 100); T.eq(h[1].source, "t"); T.truthy(h[1].old ~= nil)
end)
T.test("conflict rules", "detects and clears", function()
	T.fresh()
	T.eq(#Settings.conflicts(), 0)
	Settings.set("perf.lowProfile", true); Settings.set("lighting.blurEnabled", true)
	local c = Settings.conflicts()
	T.eq(#c, 1); T.eq(c[1].id, "lowprofile-vs-effects")
	Settings.set("lighting.blurEnabled", false)
	T.eq(#Settings.conflicts(), 0)
end)
T.test("diff", "lists differing keys only", function()
	T.fresh()
	local d = Settings.diff({ ["ui.theme"] = "Rose" }, { ["ui.theme"] = "Ocean", ["crosshair.size"] = 10 })
	T.eq(#d, 1); T.eq(d[1].key, "ui.theme")
end)
T.test("toggle", "bool flips, non-bool refused", function()
	T.fresh()
	Settings.toggle("crosshair.enabled"); T.eq(Settings.get("crosshair.enabled"), true)
	T.falsy((Settings.toggle("ui.theme")))
end)
T.test("define validation", "bad definitions assert", function()
	T.fresh()
	T.throws(function() Settings.define({ key = "bad", type = "bool", default = true, category = "x" }) end, "bad setting key")
	T.throws(function() Settings.define({ key = "ui.theme", type = "bool", default = true, category = "x" }) end, "duplicate")
	T.throws(function() Settings.define({ key = "x.y", type = "enum", default = "a", options = { "b" }, category = "x" }) end, "invalid")
end)

T.suite("Search")
T.test("name match ranks first", "exact/prefix before description hits", function()
	T.fresh()
	local r = Search.query("crosshair")
	T.truthy(#r > 0); T.truthy(string.find(string.lower(r[1].title), "crosshair"))
end)
T.test("description search", "finds by description words", function()
	T.fresh()
	local r = Search.query("reduced motion")
	local found = false
	for _, it in ipairs(r) do if it.id == "ui.animations" then found = true end end
	T.truthy(found)
end)
T.test("russian name search", "ru names indexed", function()
	T.fresh()
	local r = Search.query("прозрачность")
	T.truthy(#r > 0)
end)
T.test("AND semantics", "all tokens must match", function()
	T.fresh()
	T.eq(#Search.query("crosshair zzzzzz"), 0)
end)
T.test("category filter", "only that category", function()
	T.fresh()
	for _, it in ipairs(Search.query("", { category = "D" })) do T.eq(it.category, "D") end
	T.truthy(#Search.query("", { category = "D" }) >= 10)
end)
T.test("active filter", "reflects current settings", function()
	T.fresh()
	local before = #Search.query("", { onlyActive = true })
	Settings.set("crosshair.enabled", true)
	local after = Search.query("", { onlyActive = true })
	T.eq(#after, before + 1)
end)
T.test("favorites filter", "only pinned", function()
	T.fresh()
	Recents.toggleFavorite("ui.theme")
	local r = Search.query("", { onlyFavorites = true })
	T.eq(#r, 1); T.eq(r[1].id, "ui.theme")
end)
T.test("uncatalogued settings are searchable", "settings without a feature appear", function()
	T.fresh()
	local r = Search.query("tooltip")
	T.truthy(#r > 0)
end)
T.test("command palette", "matches actions by name/keywords", function()
	T.fresh()
	Actions.register("demo.toggle", { name = "Toggle demo", keywords = { "flip" }, fn = function() end })
	T.eq(#Search.commands("flip"), 1); T.eq(#Search.commands("zzz"), 0)
end)
T.test("limit honoured", "no more than limit", function()
	T.fresh()
	T.eq(#Search.query("", { limit = 5 }), 5)
end)

T.suite("Recents")
T.test("recent order and cap", "front insert, dedupe, max 8", function()
	T.fresh()
	for i = 1, 12 do Recents.touch("f" .. i) end
	Recents.touch("f5")
	local r = Recents.recent()
	T.eq(#r, 8); T.eq(r[1], "f5"); T.eq(r[2], "f12")
end)
T.test("favourite toggle and limit", "toggle on/off, limit 24", function()
	T.fresh()
	T.truthy(select(2, Recents.toggleFavorite("a"))); T.falsy(select(2, Recents.toggleFavorite("a")))
	for i = 1, 24 do Recents.toggleFavorite("k" .. i) end
	T.falsy((Recents.toggleFavorite("overflow")))
end)

T.suite("Actions")
T.test("run returns errors without throwing", "ok=false, logged", function()
	T.fresh()
	Actions.register("boom", { fn = function() error("x") end })
	local ok, err = Actions.run("boom")
	T.falsy(ok); T.truthy(err)
	T.falsy((Actions.run("missing")))
end)
T.test("duplicate action refused", "assert", function()
	T.fresh()
	Actions.register("a", { fn = function() end })
	T.throws(function() Actions.register("a", { fn = function() end }) end, "duplicate")
end)
