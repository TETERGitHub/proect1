T.suite("Lifecycle")
T.test("unload leaves nothing behind", "no GUI, no tasks, no maid tasks, no effects", function()
	local h, game = boot()
	Settings.set("crosshair.enabled", true); Settings.set("lighting.colorEnabled", true); Settings.set("training.enabled", true)
	local gui = Mock.game.__services.CoreGui
	T.truthy(#gui:GetChildren() > 0)
	h.unload()
	T.eq(#gui:GetChildren(), 0, "CoreGui empty")
	T.eq(Perf.taskCount(), 0, "scheduler empty")
	T.eq(#game.__services.Lighting:GetChildren(), 0)
	T.eq(#game.Workspace:GetChildren() <= 3, true)
	Mock.uninstall()
	return "maid tasks left: " .. Maid.stats().tasks
end)
T.test("reboot works and detects re-initialisation", "second run replaces the first cleanly", function()
	T.fresh(); Mock.install(); Services.clear()
	local h1 = Hub.run({ skipLicense = true })
	T.falsy(h1.replaced)
	local h2 = Hub.run({ skipLicense = true })
	T.truthy(h2.replaced)
	local running = 0
	for _, m in ipairs(Core.status()) do if m.state == "running" then running += 1 end end
	h2.unload(); Mock.uninstall()
	T.truthy(running >= 8)
end)

local Platform = import("ui/Platform")
local ScreenButtons = import("ui/ScreenButtons")
local Recents = import("core/Recents")

T.suite("Mobile")
T.test("platform detection", "touch/keyboard/viewport decide the class", function()
	T.eq(Platform.detect(true, false, 800, 400), "phone")
	T.eq(Platform.detect(true, false, 1180, 820), "tablet")
	T.eq(Platform.detect(true, true, 800, 400), "desktop")
	T.eq(Platform.detect(false, true, 1920, 1080), "desktop")
	T.eq(Platform.detect(false, false, 1280, 720), "desktop")
	T.eq(Platform.detect(true, false, 0, 0), "tablet")
end)
T.test("presets reference real settings and are valid", "every preset key exists and passes validation", function()
	T.fresh()
	for kind, preset in pairs(Platform.presets) do
		for key, value in pairs(preset) do
			T.truthy(Settings.has(key), kind .. ": " .. key)
			local _, rep = Settings.validateMap({ [key] = value }, Settings.schema(key).scope)
			T.eq(#rep.rejected, 0, kind .. ": " .. key)
		end
	end
	local Registry = import("core/Registry")
	for _, id in ipairs(Platform.defaultPins) do T.truthy(Registry.get(id), id) end
end)
T.test("phone boot applies the compact preset once", "small window, compact mode, buttons on, pins set", function()
	if Hub.current() then Hub.current().unload() end
	Mock.uninstall(); T.fresh()
	local game = Mock.install(); Services.clear()
	local uis = game:GetService("UserInputService")
	uis.TouchEnabled, uis.KeyboardEnabled = true, false
	game.Workspace.CurrentCamera.ViewportSize = Mock.v2(800, 400)
	local h = Hub.run({ skipLicense = true })
	T.eq(h.platform, "phone")
	T.eq(Settings.get("state.width"), 520); T.eq(Settings.get("state.height"), 320)
	T.truthy(Settings.get("ui.compact")); T.falsy(Settings.get("ui.showTooltips")); T.truthy(Settings.get("ui.screenButtons"))
	T.eq(Settings.get("state.platform"), "phone")
	T.eq(ScreenButtons.count(), #Platform.defaultPins)
	-- the window must fit the phone screen: scale shrinks the 520x300 window if needed
	local scale = Mock.game.__services.CoreGui.MM2Hub.Root.UIScale.Scale
	T.truthy(520 * scale <= 800 and 320 * scale <= 400, "scale " .. tostring(scale))
	-- user changes survive: the preset is not re-applied on the next boot
	Settings.set("ui.compact", false)
	h.unload(); Mock.uninstall()
end)
T.test("desktop boot leaves defaults alone", "no preset applied, no buttons", function()
