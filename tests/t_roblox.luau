local TargetSelect = import("features/TargetSelect")
T.suite("Select Aim (mock Roblox)")

-- Camera in the mock sits at (0,10,20) looking down -Z with an 800px focal length, viewport 1280x720.
-- A point (x,10,z) projects to screen x = 640 + x/(20-z)*800 and y = 360.
local function part(game, name, x, y, z)
	local p = Mock.makeInstance("Part"); p.Name = name; p.Position = Mock.v3(x, y, z); p.Parent = game.Workspace
	return p
end
local function world(game)
	local A = part(game, "A", 0, 10, -20)    -- screen x 640  (0 px from centre)  distance 40
	local B = part(game, "B", 4, 10, -20)    -- screen x 720  (80 px)             distance ~40.2
	local C = part(game, "C", 30, 10, -20)   -- screen x 1240 (600 px)
	local D = part(game, "D", 5, 10, 0)      -- screen x 840  (200 px)            distance ~20.6 (nearest)
	local list = {
		{ id = "A", name = "Alpha", part = A, alive = true }, { id = "B", name = "Bravo", part = B, alive = true },
		{ id = "C", name = "Charlie", part = C, alive = true }, { id = "D", name = "Delta", part = D, alive = true },
	}
	TargetSelect.setSource(function()
		local out = {}
		for _, t in ipairs(list) do if t.part.Parent then table.insert(out, t) end end
		return out
	end)
	return { A = A, B = B, C = C, D = D, list = list }
end
local function aimOn(extra)
	Settings.set("selectaim.enabled", true)
	for k, v in pairs(extra or {}) do Settings.set("selectaim." .. k, v) end
end

