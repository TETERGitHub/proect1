T.suite("Lighting")
T.test("effects created on demand and destroyed", "CC/Blur/Bloom instances follow switches", function()
	local h, game = boot()
	T.eq(Lighting.effectCount(), 0)
	Settings.set("lighting.colorEnabled", true); T.eq(Lighting.effectCount(), 1)
	Settings.set("lighting.blurEnabled", true); Settings.set("lighting.bloomEnabled", true); T.eq(Lighting.effectCount(), 3)
	Settings.set("perf.lowProfile", true); frames(2); T.eq(Lighting.effectCount(), 1, "blur+bloom dropped in low profile")
	Settings.set("perf.lowProfile", false); frames(2); T.eq(Lighting.effectCount(), 3)
	shutdown(h)
	T.eq(#game.__services.Lighting:GetChildren(), 0, "nothing left in Lighting")
