	T.truthy(Training.spawnDummy()); T.truthy(Training.hasDummy())
	T.truthy(Training.launch())
	T.truthy(Training.resetDummy())
	Actions.run("training.clear"); T.falsy(Training.hasDummy()); T.eq(Training.objectCount(), 0)
