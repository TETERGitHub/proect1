	l.Brightness = 1; frames(130); T.eq(l.Brightness, 4, "game overwrite re-applied")
	shutdown(h)
	T.eq(l.Brightness, 2); T.eq(l.ClockTime, 14)
end)
T.test("graphics reset action", "defaults restored", function()
