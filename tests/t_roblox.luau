T.test("music playlist add/remove and playback state", "valid entries accepted, invalid refused, play starts sound", function()
	local h = boot()
	T.truthy(Music.add("asset:12345", "Song A")); T.truthy(Music.add("file:track.mp3", "Song B"))
	T.falsy((Music.add("file:../x.mp3", "bad"))); T.falsy((Music.add("asset:12345", "dup")))
	T.eq(#Music.tracks(), 2)
	T.truthy(Music.move(1, 1)); T.eq(Music.tracks()[1].title, "Song B")
