T.test("ghost collisions only touch others and are restored", "other players' parts non-collidable, then restored", function()
	local h, game = boot()
	local other = Mock.makeInstance("Player"); other.Name = "Other"
	local char = Mock.makeInstance("Model"); local torso = Mock.makeInstance("Part"); torso.Name = "Torso"; torso.Parent = char
	torso.CanCollide = true; other.Character = char
	local mine = game.Players.LocalPlayer.Character.HumanoidRootPart; mine.CanCollide = true
	local me = game.Players.LocalPlayer
	game.Players.GetPlayers = function() return { me, other } end
	Settings.set("antifling.enabled", true); frames(15)
	T.eq(torso.CanCollide, false); T.eq(mine.CanCollide, true, "own character untouched")
	T.eq(AntiFling.ghostedParts(), 1)
	Settings.set("antifling.noCollide", false); frames(15)
	T.eq(torso.CanCollide, true); T.eq(AntiFling.ghostedParts(), 0)
	Settings.set("antifling.noCollide", true); frames(15); T.eq(torso.CanCollide, false)
	shutdown(h)
	T.eq(torso.CanCollide, true, "restored on unload")
end)

local Ghost = import("features/Ghost")
local function characterWithExtras(game)
	local p = game.Players.LocalPlayer
	local char = p.Character
	local acc = Mock.makeInstance("Accessory"); acc.Name = "Hat"; acc.Parent = char
	local hat = Mock.makeInstance("Part"); hat.Name = "Handle"; hat.Parent = acc
	local tool = Mock.makeInstance("Tool"); tool.Name = "Gun"; tool.Parent = char
	local th = Mock.makeInstance("Part"); th.Name = "Handle"; th.Parent = tool
	local face = Mock.makeInstance("Decal"); face.Name = "face"; face.Transparency = 0; face.Parent = char.Head
	return char, hat, th, face
end

T.suite("Ghost (mock Roblox)")
T.test("fades own parts to the chosen level and restores everything", "LocalTransparencyModifier follows opacity, 0 after disable", function()
	local h, game = boot()
	local char, hat, toolHandle, face = characterWithExtras(game)
	Settings.set("ghost.opacity", 0.15); Settings.set("ghost.enabled", true); frames(150)
	T.truthy(math.abs(char.Head.LocalTransparencyModifier - 0.85) < 0.02, tostring(char.Head.LocalTransparencyModifier))
	T.truthy(math.abs(hat.LocalTransparencyModifier - 0.85) < 0.02, "accessory")
	T.eq(toolHandle.LocalTransparencyModifier, 0, "tool excluded by default")
	T.eq(char.HumanoidRootPart.LocalTransparencyModifier, 0, "root part untouched")
