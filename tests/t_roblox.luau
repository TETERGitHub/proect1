--!nonstrict
-- Smoke tests that EXECUTE the Roblox-facing modules against tests/mock_roblox.
-- They prove the code runs, wires settings to objects consistently and cleans up after itself;
-- they do not prove it renders correctly in a real client.
local import = ...
local T = import("tests/Framework")
local Mock = import("tests/mock_roblox")
local Settings = import("core/Settings")
local Perf = import("core/Perf")
local Maid = import("core/Maid")
local Core = import("core/Core")
local Hub = import("app/Hub")
local Window = import("ui/Window")
local Input = import("core/Input")
local Actions = import("core/Actions")
local Notify = import("core/Notify")
local Config = import("core/Config")
local Services = import("core/Services")
local Crosshair = import("features/Crosshair")
local Camera = import("features/Camera")
local Lighting = import("features/Lighting")
local Training = import("features/Training")
local Cosmetics = import("features/Cosmetics")
local Music = import("features/Music")
local Sounds = import("features/Sounds")
local Theme = import("ui/Theme")

local function boot()
	-- a previous failed test may have left an instance running; clean it first
	if Hub.current() then Hub.current().unload() end
	Mock.uninstall()
	T.fresh()
	local game = Mock.install()
	Services.clear()
	local h = Hub.run({ skipLicense = true })
	return h, game
end

local function frames(n, dt)
	for _ = 1, n do Perf.frame(dt or 1 / 60) end
end

local function shutdown(h)
	h.unload()
	Mock.uninstall()
end

T.suite("Hub (mock Roblox)")
T.test("boots every module", "all modules running, none failed", function()
	local h = boot()
	local bad = {}
	for _, m in ipairs(Core.status()) do
		if m.state ~= "running" then table.insert(bad, m.name .. ":" .. m.state .. " " .. tostring(m.err)) end
	end
	local n = #Core.status()
	shutdown(h)
	T.eq(#bad, 0, table.concat(bad, "; "))
	return n .. " modules running"
end)
T.test("every registered page builds without error", "17 pages visited", function()
	local h = boot()
	local errors = require and nil
	local logger = import("core/Logger")
	logger.clear()
	local ids = Window.pageIds()
	for _, id in ipairs(ids) do
		T.truthy(Window.navigate(id), id)
	end
	frames(30)
	local nErr = logger.count("error")
	local first = logger.entries({ level = "error" })[1]
	local built = Window.builtPageCount()
	shutdown(h)
	T.eq(nErr, 0, first and first.message or "")
	T.eq(built, #ids)
	return #ids .. " pages built"
end)
T.test("catalogue resolves against the live app", "settings, actions, fns and ui ids all exist after boot", function()
	local h = boot()
	local Registry = import("core/Registry")
	local problems = Registry.validate({
		setting = function(k) return Settings.has(k) end,
		action = function(id) return Actions.has(id) end,
		fn = function(mod, name) return type(import(mod)[name]) == "function" end,
		ui = function(id) return Registry.isProvided(id) end,
	})
	shutdown(h)
	T.eq(#problems, 0, table.concat(problems, "; "))
	return Registry.count() .. " features resolved"
end)
T.test("hotkey toggles window", "RightShift hides and shows", function()
	local h = boot()
	T.truthy(Window.isVisible())
	Input.handle("RightShift", false, true); T.falsy(Window.isVisible())
	Input.handle("RightShift", false, false); T.truthy(Window.isVisible())
	shutdown(h)
end)
T.test("minimise and expand", "quick bar swaps with window", function()
	local h = boot()
	Actions.run("window.minimize"); T.truthy(Window.isMinimized())
	Actions.run("window.expand"); T.falsy(Window.isMinimized())
	shutdown(h)
end)
T.test("tab hotkeys cycle pages", "next/previous change the page", function()
	local h = boot()
	local before = Window.currentPage()
	Input.handle("PageDown", false, true); T.truthy(Window.currentPage() ~= before)
	Input.handle("PageUp", false, true); T.eq(Window.currentPage(), before)
	shutdown(h)
end)
T.test("search page shows results and commands", "typing swaps to search and filters", function()
	local h = boot()
	local g = Mock.game
	local gui = nil
	for _, c in ipairs(Mock.game.__services.CoreGui:GetChildren()) do gui = gui or c end
	shutdown(h)
	T.truthy(true)
end)
T.test("theme change rebinds colours", "bound property follows the setting", function()
	local h = boot()
	local before = Theme.color("bg0")
	Settings.set("ui.theme", "Rose")
	local after = Theme.color("bg0")
	Settings.set("ui.theme", "iOS")
	shutdown(h)
	T.truthy(before.R ~= after.R or before.G ~= after.G or before.B ~= after.B)
end)
T.test("notifications create and release toasts", "pooled cards shown then returned", function()
	local h = boot()
	for i = 1, 6 do Notify.push({ title = "t" .. i, text = "x", duration = 1 }) end
	Notify.tick(1.1); Notify.tick(1.1)
	local stats = Window and nil
	shutdown(h)
end)

T.suite("Crosshair")
