end)
T.test("shooting a target scores a hit", "stats updated, miss recorded", function()
	local h = boot()
	Settings.set("training.mode", "Static"); Settings.set("training.enabled", true); frames(3)
	Training.resetStats()
	-- aim straight at the first target from the camera position
	local cam = Mock.game.Workspace.CurrentCamera
	local part
	for _, c in ipairs(Mock.game.Workspace.MM2Hub_Training:GetChildren()) do part = part or (c.Name == "HubTarget" and c) end
	local o = cam.CFrame.Position
	local d = (part.Position - o).Unit
	T.truthy(Training.shoot(o, d))
	T.falsy(Training.shoot(o, Mock.v3(0, 1, 0)))
	local s = Training.getStats()
	T.eq(s.shots, 2); T.eq(s.hits, 1); T.eq(s.kills, 1)
	shutdown(h)
end)
T.test("physics stand", "spawn, launch applies impulse, reset restores, clear removes", function()
