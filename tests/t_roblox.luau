T.test("disabled guard does nothing", "no blocks while off", function()
	local h, game = boot()
	local hrp = game.Players.LocalPlayer.Character.HumanoidRootPart
	hrp.AssemblyLinearVelocity = Mock.v3(900, 0, 0); frames(10)
