	local h = boot()
	Settings.set("crosshair.enabled", true); frames(3)
	T.eq(Crosshair.elementCount(), 4)
	Settings.set("crosshair.centerDot", true); frames(3); T.eq(Crosshair.elementCount(), 5)
	Settings.set("crosshair.style", "CrossCircle"); frames(3); T.eq(Crosshair.elementCount(), 6)
	Settings.set("crosshair.style", "Dot"); frames(3); T.eq(Crosshair.elementCount(), 1)
	Settings.set("crosshair.enabled", false); frames(3); T.eq(Crosshair.elementCount(), 0)
