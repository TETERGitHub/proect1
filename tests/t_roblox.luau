	local p = game.Players.LocalPlayer
	local hrp = p.Character.HumanoidRootPart
	Settings.set("antifling.enabled", true)
	hrp.AssemblyLinearVelocity = Mock.v3(8, 0, 0); frames(40)  -- normal: remembered as safe, not blocked
