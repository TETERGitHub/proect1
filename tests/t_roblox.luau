	T.eq(game.__services.CoreGui:FindFirstChild("MM2HubSelectFov"), nil)
	Mock.uninstall()
	local h2, game2 = boot()
	world(game2); aimOn(); frames(5)
	T.eq(TargetSelect.selectedId(), "A"); T.eq(Perf.taskCount() > 0, true)
	T.truthy(before > 0)
	shutdown(h2)
end)
T.test("a failing target source cannot crash the selector", "error is logged, selection simply empties", function()
	local h, game = boot()
	TargetSelect.setSource(function() error("source exploded") end)
	aimOn(); frames(10)
	T.eq(TargetSelect.selectedId(), nil)
	T.truthy(import("core/Logger").count("error") >= 1)
	shutdown(h)
end)
