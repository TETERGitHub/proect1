--!nonstrict
local import = ...
local T = import("tests/Framework")
local Settings = import("core/Settings")
local Actions = import("core/Actions")
local Input = import("core/Input")

local function setup()
	T.fresh()
	local calls = {}
	for _, id in ipairs({ "a", "b", "hubonly" }) do
		Actions.register(id, { name = "Action " .. id, fn = function() table.insert(calls, id) end })
	end
	Input.bind("a", "F1"); Input.bind("b", "None"); Input.bind("hubonly", "F2", { hubOnly = true })
	return calls
end

T.suite("Input")
T.test("bound key runs action", "action fired once", function()
	local calls = setup()
	T.deepEq(Input.handle("F1", false, false), { "a" }); T.eq(#calls, 1)
	T.deepEq(Input.handle("F9", false, false), {})
end)
T.test("hubOnly needs visible hub", "ignored when hidden", function()
	local calls = setup()
	Input.handle("F2", false, false); T.eq(#calls, 0)
	Input.handle("F2", false, true); T.eq(#calls, 1)
end)
T.test("typing guard", "ignored while typing, honours setting", function()
	local calls = setup()
	Input.handle("F1", true, true); T.eq(#calls, 0)
	Settings.set("input.ignoreTyping", false)
	Input.handle("F1", true, true); T.eq(#calls, 1)
end)
T.test("master switch", "all hotkeys off", function()
	local calls = setup()
	Settings.set("input.enabled", false)
	Input.handle("F1", false, true); T.eq(#calls, 0)
end)
T.test("rebind refuses conflict", "error names the other action", function()
	setup()
	local ok, err, other = Input.rebind("b", "F1")
	T.falsy(ok); T.eq(other, "a"); T.truthy(string.find(err, "Action a"))
	T.eq(Input.keyOf("a"), "F1")
end)
T.test("rebind force steals key", "old owner set to None", function()
	setup()
	T.truthy(Input.rebind("b", "F1", true))
	T.eq(Input.keyOf("a"), "None"); T.eq(Input.keyOf("b"), "F1")
end)
T.test("rebind validation", "invalid key names rejected", function()
	setup()
	T.falsy((Input.rebind("a", "bad key!"))); T.falsy((Input.rebind("a", 5))); T.falsy((Input.rebind("zzz", "F5")))
end)
T.test("clear and reset binding", "None then default", function()
	setup()
	Input.rebind("a", "G"); T.truthy(Input.clear("a")); T.eq(Input.keyOf("a"), "None")
	Input.resetBinding("a"); T.eq(Input.keyOf("a"), "F1")
end)
T.test("conflict listing", "duplicates found, None ignored", function()
	setup()
	T.eq(#Input.conflicts(), 0)
	Settings.set("keys.b", "F1")
	local c = Input.conflicts()
	T.eq(#c, 1); T.eq(c[1].key, "F1"); T.eq(#c[1].actions, 2)
end)
T.test("capture delivers next key", "callback gets key, hotkeys suppressed", function()
	local calls = setup()
	local got
	Input.startCapture(function(k) got = k end)
	T.truthy(Input.isCapturing())
	Input.handle("F1", false, true)
	T.eq(got, "F1"); T.falsy(Input.isCapturing()); T.eq(#calls, 0)
end)
T.test("capture cancelled by Escape", "callback gets nil", function()
	setup()
	local got, called = "x", false
	Input.startCapture(function(k) got = k; called = true end)
	Input.handle("Escape", false, true)
	T.truthy(called); T.eq(got, nil)
end)
T.test("focus loss cancels capture and clears keys", "state reset", function()
	setup()
	local cancelled = false
	Input.startCapture(function(k) if k == nil then cancelled = true end end)
	Input.handle("W", false, true)
	Input.startCapture(function(k) if k == nil then cancelled = true end end)
	Input.focusLost()
	T.truthy(cancelled); T.falsy(Input.isCapturing()); T.falsy(Input.isDown("W"))
end)
T.test("rebound persists in settings", "stored under keys.<id>", function()
	setup()
	Input.rebind("a", "H")
	T.eq(Settings.get("keys.a"), "H")
end)
T.test("bind requires existing action", "assert", function()
	T.fresh()
	T.throws(function() Input.bind("ghost", "F1") end, "unknown action")
end)
