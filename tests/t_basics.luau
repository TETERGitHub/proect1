--!nonstrict
local import = ...
local T = import("tests/Framework")
local Signal = import("core/Signal")
local Maid = import("core/Maid")
local Logger = import("core/Logger")
local Json = import("core/Json")
local Codec = import("core/Codec")
local Version = import("core/Version")
local Pool = import("core/Pool")

T.suite("Signal")
T.test("fire reaches handlers in order", "handlers run in registration order", function()
	local s, out = Signal.new(), {}
	s:Connect(function(x) table.insert(out, "a" .. x) end)
	s:Connect(function(x) table.insert(out, "b" .. x) end)
	s:Fire(1)
	T.eq(table.concat(out, ","), "a1,b1")
end)
T.test("disconnect stops delivery", "no call after Disconnect", function()
	local s, n = Signal.new(), 0
	local c = s:Connect(function() n += 1 end)
	s:Fire(); c:Disconnect(); s:Fire()
	T.eq(n, 1); T.eq(s:Count(), 0); T.falsy(c.Connected)
end)
T.test("Once fires a single time", "one call", function()
	local s, n = Signal.new(), 0
	s:Once(function() n += 1 end)
	s:Fire(); s:Fire()
	T.eq(n, 1)
end)
T.test("handler error is isolated", "second handler still runs, error reported", function()
	local s, ran, reported = Signal.new("S"), false, nil
	Signal.onError = function(msg, name) reported = name end
	s:Connect(function() error("boom") end)
	s:Connect(function() ran = true end)
	s:Fire()
	Signal.onError = nil
	T.truthy(ran); T.eq(reported, "S")
end)
T.test("disconnect during fire is safe", "snapshot iteration", function()
	local s, n = Signal.new(), 0
	local c2
	s:Connect(function() c2:Disconnect() end)
	c2 = s:Connect(function() n += 1 end)
	s:Fire()
	T.eq(n, 0)
end)
T.test("invalid handler rejected", "assert on non-function", function()
	T.throws(function() Signal.new():Connect(5) end, "expects a function")
end)

T.suite("Maid")
T.test("Clean disposes newest first", "reverse order", function()
	local m, out = Maid.new("t"), {}
	m:Give(function() table.insert(out, 1) end)
	m:Give(function() table.insert(out, 2) end)
	m:Clean()
	T.eq(table.concat(out, ","), "2,1"); T.eq(m:Count(), 0)
end)
T.test("disconnects Signal connections", "connection released", function()
	local s, m = Signal.new(), Maid.new("t")
	m:Give(s:Connect(function() end))
	T.eq(s:Count(), 1); m:Clean(); T.eq(s:Count(), 0)
end)
T.test("GiveNamed replaces previous", "old task cleaned", function()
	local m, cleaned = Maid.new("t"), 0
	m:GiveNamed("x", function() cleaned += 1 end)
	m:GiveNamed("x", function() end)
	T.eq(cleaned, 1)
end)
T.test("failing task does not block others", "errors collected, rest cleaned", function()
	local m, ran = Maid.new("t"), false
	m:Give(function() ran = true end)
	m:Give(function() error("bad") end)
	local errs = m:Clean()
	T.eq(#errs, 1); T.truthy(ran)
end)
T.test("unsupported task rejected", "error on Give(number)", function()
	T.throws(function() Maid.new("t"):Give(5) end, "unsupported")
end)
T.test("stats count live tasks", "tasks counted across maids", function()
	local m = Maid.new("stat-test")
	m:Give(function() end); m:Give(function() end)
	T.truthy(Maid.stats().tasks >= 2)
	T.eq(Maid.breakdown()[1].tasks >= 2, true)
	m:Clean()
end)

T.suite("Logger")
T.test("levels and counters", "counts per level", function()
	Logger.reset()
	Logger.info("t", "hello %s", "x"); Logger.warn("t", "w"); Logger.error("t", "e")
	T.eq(Logger.count("info"), 1); T.eq(Logger.count("warn"), 1); T.eq(Logger.count("error"), 1)
	T.eq(Logger.entries()[1].message, "hello x")
end)
T.test("ring buffer cap", "never exceeds capacity", function()
	Logger.reset()
	for i = 1, Logger.CAPACITY + 50 do Logger.info("t", "m%d", i) end
	T.eq(#Logger.entries(), Logger.CAPACITY)
	T.eq(Logger.entries()[#Logger.entries()].message, "m" .. (Logger.CAPACITY + 50))
end)
T.test("bad format string survives", "no throw", function()
	Logger.reset()
	Logger.info("t", "%d", "notanumber")
	T.truthy(Logger.entries()[1].message ~= nil)
end)
T.test("min level filters", "debug dropped", function()
	Logger.reset(); Logger.setMinLevel("warn")
	Logger.info("t", "x"); Logger.warn("t", "y")
	T.eq(#Logger.entries(), 1); Logger.setMinLevel("debug")
end)
T.test("filter by level", "only >= level", function()
	Logger.reset()
	Logger.info("a", "1"); Logger.error("b", "2")
	T.eq(#Logger.entries({ level = "warn" }), 1)
	T.eq(#Logger.entries({ tag = "a" }), 1)
end)

T.suite("Json")
T.test("roundtrip nested", "decode(encode(x)) == x", function()
	local v = { a = 1, b = { 1, 2, 3 }, c = { d = "é\n\"q\"", e = true }, f = 0.25 }
	local back = Json.decode(Json.encode(v))
	T.eq(back.a, 1); T.eq(back.b[3], 3); T.eq(back.c.d, "é\n\"q\""); T.eq(back.c.e, true); T.eq(back.f, 0.25)
end)
T.test("deterministic key order", "same output for same data", function()
	T.eq(Json.encode({ z = 1, a = 2, m = 3 }), '{"a":2,"m":3,"z":1}')
end)
T.test("rejects malformed input", "nil + error message", function()
	for _, bad in ipairs({ "", "{", '{"a":}', "[1,]", '{"a":1,"a":2}', "nul", "01", '"\\x"', "{} extra" }) do
		local v, err = Json.decode(bad)
		T.eq(v, nil, "should reject: " .. bad); T.truthy(err)
	end
end)
T.test("unicode escapes", "surrogate pair decoded", function()
	T.eq(Json.decode('"\\u00e9\\ud83d\\ude00"'), "é😀")
end)
T.test("depth limit", "deep nesting rejected not crashed", function()
	local v, err = Json.decode(string.rep("[", 200) .. string.rep("]", 200))
	T.eq(v, nil); T.truthy(err)
end)
T.test("NaN not encodable", "tryEncode returns error", function()
	local s, err = Json.tryEncode({ a = 0 / 0 })
	T.eq(s, nil); T.truthy(err)
end)
T.test("integers print without decimals", "42 not 42.0", function()
	T.eq(Json.encode({ n = 42 }), '{"n":42}')
end)

T.suite("Codec")
T.test("base64 known vectors", "RFC 4648 vectors", function()
	T.eq(Codec.b64encode(""), ""); T.eq(Codec.b64encode("f"), "Zg=="); T.eq(Codec.b64encode("fo"), "Zm8=")
	T.eq(Codec.b64encode("foo"), "Zm9v"); T.eq(Codec.b64encode("foobar"), "Zm9vYmFy")
end)
T.test("base64 roundtrip binary", "all byte values", function()
	local bytes = {}
	for i = 0, 255 do table.insert(bytes, string.char(i)) end
	local s = table.concat(bytes)
	T.eq(Codec.b64decode(Codec.b64encode(s)), s)
end)
T.test("base64 rejects garbage", "nil + error", function()
	T.eq((Codec.b64decode("abc")), nil); T.eq((Codec.b64decode("ab!d")), nil); T.eq((Codec.b64decode("Zg==Zg==")), nil)
end)
T.test("fnv1a known values", "FNV-1a 32 vectors", function()
	T.eq(Codec.fnv1a(""), "811c9dc5"); T.eq(Codec.fnv1a("a"), "e40c292c"); T.eq(Codec.fnv1a("foobar"), "bf9cf968")
end)

T.suite("Version")
T.test("compare semver", "numeric not lexical", function()
	T.eq(Version.compare("1.2.0", "1.10.0"), -1); T.eq(Version.compare("2.0", "2.0.0"), 0); T.eq(Version.compare("3.1", "3.0.9"), 1)
end)
T.test("migrate runs chain", "schema 0 -> current", function()
	Version.clearMigrations()
	local saved = Version.SCHEMA
	Version.SCHEMA = 2
	Version.registerMigration(0, function(d) d.settings.renamed = d.settings.old; d.settings.old = nil; return d end)
	Version.registerMigration(1, function(d) d.settings.flag = true; return d end)
	local data, notes, err = Version.migrate({ schema = 0, settings = { old = 5 } })
	Version.SCHEMA = saved; Version.clearMigrations()
	T.eq(err, nil); T.eq(data.settings.renamed, 5); T.eq(data.settings.flag, true); T.eq(#notes, 2); T.eq(data.schema, 2)
end)
T.test("newer schema refused", "error mentions newer", function()
	local d, _, err = Version.migrate({ schema = Version.SCHEMA + 1, settings = {} })
	T.eq(d, nil); T.truthy(string.find(err, "newer"))
end)
T.test("missing migration reported", "error not crash", function()
	local saved = Version.SCHEMA
	Version.SCHEMA = 3
	local d, _, err = Version.migrate({ schema = 1, settings = {} })
	Version.SCHEMA = saved
	T.eq(d, nil); T.truthy(err)
end)
T.test("failing migration contained", "pcall wrapped", function()
	local saved = Version.SCHEMA
	Version.SCHEMA = 1
	Version.registerMigration(0, function() error("nope") end)
	local d, _, err = Version.migrate({ schema = 0, settings = {} })
	Version.SCHEMA = saved; Version.clearMigrations()
	T.eq(d, nil); T.truthy(string.find(err, "failed"))
end)

T.suite("Pool")
T.test("objects are reused", "second acquire reuses", function()
	local made = 0
	local p = Pool.new({ create = function() made += 1; return { n = made } end, reset = function(o) o.dirty = false end })
	local a = p:Acquire(); p:Release(a); local b = p:Acquire()
	T.eq(made, 1); T.eq(a, b); T.eq(p:Stats().reused, 1)
end)
T.test("max free enforced", "excess destroyed", function()
	local destroyed = 0
	local p = Pool.new({ create = function() return {} end, destroy = function() destroyed += 1 end, max = 1 })
	local a, b = p:Acquire(), p:Acquire()
	p:Release(a); p:Release(b)
	T.eq(p:Free(), 1); T.eq(destroyed, 1)
end)
T.test("failing reset destroys object", "not returned to pool", function()
	local destroyed = 0
	local p = Pool.new({ create = function() return {} end, reset = function() error("x") end, destroy = function() destroyed += 1 end })
	p:Release(p:Acquire())
	T.eq(p:Free(), 0); T.eq(destroyed, 1)
end)

local ColorUtil = import("core/ColorUtil")
T.suite("ColorUtil")
T.test("HSV roundtrip", "rgb -> hsv -> rgb is stable (±1)", function()
	local samples = { { 0, 0, 0 }, { 255, 255, 255 }, { 255, 0, 0 }, { 12, 200, 99 }, { 110, 120, 255 }, { 1, 2, 3 }, { 254, 253, 0 } }
	for _, s in ipairs(samples) do
		local h, sat, v = ColorUtil.toHSV(s[1], s[2], s[3])
		local r, g, b = ColorUtil.fromHSV(h, sat, v)
		T.truthy(math.abs(r - s[1]) <= 1 and math.abs(g - s[2]) <= 1 and math.abs(b - s[3]) <= 1, table.concat(s, ","))
	end
end)
T.test("hex parse/format", "valid and invalid forms", function()
	local c = ColorUtil.fromHex("#6e78ff"); T.eq(c.r, 110); T.eq(c.b, 255); T.eq(ColorUtil.toHex(c), "#6E78FF")
	T.eq(ColorUtil.fromHex("fa0").g, 0xaa)
	for _, bad in ipairs({ "", "#12", "#GGGGGG", "#1234567", "red" }) do T.eq(ColorUtil.fromHex(bad), nil, bad) end
end)
T.test("mix and contrast", "endpoints and ratio bounds", function()
	local a, b = { r = 0, g = 0, b = 0 }, { r = 255, g = 255, b = 255 }
	T.eq(ColorUtil.mix(a, b, 0).r, 0); T.eq(ColorUtil.mix(a, b, 1).g, 255); T.eq(ColorUtil.mix(a, b, 0.5).b, 128)
	T.truthy(math.abs(ColorUtil.contrast(a, b) - 21) < 0.01)
end)
