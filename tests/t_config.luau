--!nonstrict
local import = ...
local T = import("tests/Framework")
local Settings = import("core/Settings")
local Config = import("core/Config")
local Env = import("core/Env")
local Json = import("core/Json")
local Codec = import("core/Codec")
local Version = import("core/Version")

-- Fake executor file API backed by a table, so the persistent path is tested too.
local function fakeLookup(files)
	local api = {
		writefile = function(p, t) files[p] = t end,
		readfile = function(p) return files[p] end,
		isfile = function(p) return files[p] ~= nil end,
		makefolder = function() end,
		isfolder = function() return true end,
		delfile = function(p) files[p] = nil end,
		setclipboard = function(t) files.__clip = t end,
	}
	return function(name) return api[name] end
end

T.suite("Config")
T.test("init creates Default and index", "Default exists and is active", function()
	T.fresh()
	local rep = Config.init()
	T.deepEq(Config.list(), { "Default" }); T.eq(Config.active(), "Default"); T.eq(rep.profiles, 1)
end)
T.test("name validation", "bad names rejected", function()
	T.fresh(); Config.init()
	for _, bad in ipairs({ "", string.rep("x", 33), "a/b", "../x", "a.b", 5 }) do
		T.falsy((Config.validateName(bad)), tostring(bad))
	end
	T.truthy((Config.validateName("My Cfg-1_x")))
end)
T.test("create / duplicate / rename / delete", "profile lifecycle", function()
	T.fresh(); Config.init()
	T.truthy(Config.create("Alt")); T.falsy((Config.create("alt")), "case-insensitive unique")
	T.truthy(Config.duplicate("Alt", "Alt2")); T.truthy(Config.rename("Alt2", "Third"))
	T.deepEq(Config.list(), { "Alt", "Default", "Third" })
	T.truthy(Config.delete("Third")); T.deepEq(Config.list(), { "Alt", "Default" })
	T.falsy((Config.rename("Nope", "x")))
end)
T.test("cannot delete last profile", "refused", function()
	T.fresh(); Config.init()
	local ok, err = Config.delete("Default")
	T.falsy(ok); T.truthy(err)
end)
T.test("deleting active profile switches", "another profile loaded", function()
	T.fresh(); Config.init()
	Config.create("Other")
	T.truthy(Config.delete("Default"))
	T.eq(Config.active(), "Other")
end)
T.test("save and load roundtrip", "settings restored", function()
	T.fresh(); Config.init()
	Settings.set("ui.theme", "Rose"); Settings.set("crosshair.size", 33)
	Config.save()
	Settings.set("ui.theme", "Ocean"); Settings.set("crosshair.size", 5)
	local ok = Config.load("Default")
	T.truthy(ok); T.eq(Settings.get("ui.theme"), "Rose"); T.eq(Settings.get("crosshair.size"), 33)
end)
T.test("profiles are independent", "switching profiles swaps values", function()
	T.fresh(); Config.init()
	Settings.set("ui.theme", "Rose"); Config.save()
	Config.create("Blank")
	Config.load("Blank"); T.eq(Settings.get("ui.theme"), "iOS 27 Glass")
	Config.load("Default"); T.eq(Settings.get("ui.theme"), "Rose")
end)
T.test("export/import roundtrip", "string reproduces settings", function()
	T.fresh(); Config.init()
	Settings.set("ui.theme", "Forest"); Settings.set("ui.accent", { r = 1, g = 2, b = 3 }); Config.save()
	local s = Config.exportString("Default")
	T.truthy(string.sub(s, 1, 8) == "MM2HUB1:")
	local ok, rep = Config.importString(s, "Copy")
	T.truthy(ok, rep.error); T.eq(rep.name, "Copy")
	Config.load("Copy")
	T.eq(Settings.get("ui.theme"), "Forest"); T.eq(Settings.get("ui.accent").b, 3)
end)
T.test("import collision gets unique name", "suffix appended", function()
	T.fresh(); Config.init()
	local s = Config.exportString("Default")
	local _, r1 = Config.importString(s); local _, r2 = Config.importString(s)
	T.truthy(r1.name ~= r2.name and r1.name ~= "Default")
end)
T.test("import rejects tampering", "checksum/prefix/base64/json errors", function()
	T.fresh(); Config.init()
	local good = Config.exportString("Default")
	local json = Codec.b64decode(string.sub(good, 9))
	local tampered = "MM2HUB1:" .. Codec.b64encode((string.gsub(json, '"iOS"', '"Ocean"')))
	local cases = { "hello", "MM2HUB1:!!!", "MM2HUB1:" .. Codec.b64encode("{not json"), tampered, "MM2HUB1:" .. Codec.b64encode("[]"), 42, string.rep("x", 300000) }
	for i, c in ipairs(cases) do
		local ok, rep = Config.importString(c)
		T.falsy(ok, "case " .. i); T.truthy(rep.error, "case " .. i)
	end
	T.deepEq(Config.list(), { "Default" })
end)
T.test("import reports invalid values", "bad value rejected, rest kept", function()
	T.fresh(); Config.init()
	local map = Settings.snapshot("profile")
	map["ui.theme"] = "Rose"; map["ui.scale"] = "bad"; map["fake.key"] = 1
	local payload = { schema = Version.SCHEMA, name = "X", settings = map, checksum = Codec.fnv1a(Json.encode(map)) }
	local ok, rep = Config.importString("MM2HUB1:" .. Codec.b64encode(Json.encode(payload)))
	T.truthy(ok); T.eq(#rep.rejected, 1); T.eq(#rep.unknown, 1)
	Config.load(rep.name); T.eq(Settings.get("ui.theme"), "Rose"); T.eq(Settings.get("ui.scale"), 1)
end)
T.test("import from newer schema", "refused with message", function()
	T.fresh(); Config.init()
	local map = Settings.snapshot("profile")
	local payload = { schema = Version.SCHEMA + 5, name = "X", settings = map, checksum = Codec.fnv1a(Json.encode(map)) }
	local ok, rep = Config.importString("MM2HUB1:" .. Codec.b64encode(Json.encode(payload)))
	T.falsy(ok); T.truthy(string.find(rep.error, "newer"))
end)
T.test("diff of profiles and live", "key-level differences", function()
	T.fresh(); Config.init()
	Config.create("B"); Config.load("B"); Settings.set("ui.theme", "Rose"); Config.save("B")
	local d = Config.diff("Default", "B")
	T.eq(#d, 1); T.eq(d[1].key, "ui.theme")
	Settings.set("crosshair.size", 40)
	T.eq(#Config.diff("B", nil), 1)
	T.eq(select(1, Config.diff("zzz", "B")), nil)
end)
T.test("integrity check finds corruption", "tampered file flagged", function()
	local files = {}
	T.fresh({ lookup = fakeLookup(files) }); Config.init()
	Config.create("Good")
	T.truthy(Config.checkIntegrity()[1].ok)
	files["MM2Hub/profiles/Good.json"] = string.gsub(files["MM2Hub/profiles/Good.json"], "iOS", "Ocean")
	local bad
	for _, r in ipairs(Config.checkIntegrity()) do if r.name == "Good" then bad = r end end
	T.falsy(bad.ok); T.truthy(string.find(bad.problem, "checksum"))
end)
T.test("persistence across restart", "files restore state after re-init", function()
	local files = {}
	T.fresh({ lookup = fakeLookup(files) }); Config.init()
	Config.attach()
	Settings.set("ui.theme", "Ocean"); Settings.set("state.width", 900)
	Config.tick(3)
	T.falsy(Config.isDirty())
	T.fresh({ lookup = fakeLookup(files) }); Config.init()
	T.eq(Settings.get("ui.theme"), "Ocean"); T.eq(Settings.get("state.width"), 900)
end)
T.test("autosave is debounced", "no write before delay", function()
	local files = {}
	T.fresh({ lookup = fakeLookup(files) }); Config.init(); Config.attach()
	Settings.set("ui.theme", "Rose")
	Config.tick(1); T.truthy(Config.isDirty())
	Config.tick(1.5); T.falsy(Config.isDirty())
end)
T.test("corrupt state file ignored", "defaults used, no crash", function()
	local files = { ["MM2Hub/state.json"] = "{garbage" }
	T.fresh({ lookup = fakeLookup(files) })
	local rep = Config.init()
	T.eq(rep.active, "Default"); T.eq(Settings.get("state.width"), 820)
end)
T.test("corrupt active profile reported", "init notes the failure", function()
	local files = {}
	T.fresh({ lookup = fakeLookup(files) }); Config.init()
	files["MM2Hub/profiles/Default.json"] = "nonsense"
	T.fresh({ lookup = fakeLookup(files) })
	local rep = Config.init()
	T.truthy(#rep.notes >= 1)
end)
T.test("memory fallback without file API", "works and reports non-persistent", function()
	T.fresh(); local rep = Config.init()
	T.falsy(rep.persistent); T.truthy(Config.create("Mem"))
end)
T.test("profile limit", "20 max", function()
	T.fresh(); Config.init()
	for i = 1, 19 do T.truthy(Config.create("p" .. i), "p" .. i) end
	T.falsy((Config.create("overflow")))
end)

T.suite("Env")
T.test("capability detection from lookup", "reports only functions", function()
	T.fresh({ lookup = fakeLookup({}) })
	T.truthy(Env.has("writefile")); T.falsy(Env.has("gethui")); T.truthy(Env.persistent())
end)
T.test("clipboard", "returns false without setclipboard", function()
	T.fresh()
	local ok, err = Env.clipboard("x")
	T.falsy(ok); T.truthy(err)
	local files = {}
	T.fresh({ lookup = fakeLookup(files) })
	T.truthy(Env.clipboard("hello")); T.eq(files.__clip, "hello")
end)
T.test("write failure is contained", "pcall wrapped", function()
	T.fresh({ lookup = function(n) if n == "writefile" then return function() error("disk full") end end return ({ readfile = function() end, isfile = function() return false end })[n] end })
	local ok, err = Env.write("MM2Hub/x.txt", "a")
	T.falsy(ok); T.truthy(string.find(err, "disk full"))
end)
