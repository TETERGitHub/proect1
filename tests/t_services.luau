T.suite("Notify")
T.test("show, expire, promote", "queue drains as timers expire", function()
	T.fresh()
	local shown, expired = 0, 0
	Notify.Shown:Connect(function() shown += 1 end); Notify.Expired:Connect(function() expired += 1 end)
	for i = 1, 6 do Notify.push({ title = "t" .. i, duration = 2 }) end
	T.eq(#Notify.active(), 4); T.eq(Notify.queued(), 2)
	Notify.tick(2.1)
	T.eq(expired, 4); T.eq(#Notify.active(), 2); T.eq(Notify.queued(), 0)
	Notify.tick(2.1)
	T.eq(shown, 6); T.eq(#Notify.active(), 0)
end)
T.test("perf.maxDecor limits visible toasts", "setting caps visible count", function()
	T.fresh()
	Settings.set("perf.maxDecor", 2)
	for i = 1, 4 do Notify.push({ title = "x", duration = 5 }) end
	T.eq(#Notify.active(), 2)
end)
T.test("notifications off", "suppressed except errors", function()
	T.fresh()
	Settings.set("ui.notifications", false)
	T.eq(Notify.push({ title = "a" }), nil)
	T.truthy(Notify.push({ title = "b", level = "error" }))
end)
T.test("dismiss", "active and queued removable", function()
	T.fresh()
	local ids = {}
	for i = 1, 5 do ids[i] = Notify.push({ title = "x", duration = 9 }) end
	T.truthy(Notify.dismiss(ids[1])); T.eq(#Notify.active(), 4); T.eq(Notify.queued(), 0)
	T.falsy(Notify.dismiss(9999))
end)
T.test("default duration from settings", "ui.notifyDuration used", function()
	T.fresh()
	Settings.set("ui.notifyDuration", 7)
	Notify.push({ title = "x" })
	T.eq(Notify.active()[1].duration, 7)
end)

T.suite("Perf")
T.test("scheduler honours rate", "10 Hz task runs ~10 times per second", function()
	T.fresh()
	local n = 0
	Perf.every("t", 10, function() n += 1 end)
	for _ = 1, 60 do Perf.frame(1 / 60) end
	T.truthy(n >= 9 and n <= 11, "ran " .. n); return "ran " .. n .. " times in 1 s"
end)
T.test("visual tasks capped by perf.visualHz", "30 Hz cap", function()
	T.fresh()
	Settings.set("perf.visualHz", 10)
	local n = 0
	Perf.every("v", 60, function() n += 1 end, { visual = true })
	for _ = 1, 60 do Perf.frame(1 / 60) end
	T.truthy(n >= 9 and n <= 11, "ran " .. n)
end)
T.test("low profile halves rate", "rate x0.5", function()
	T.fresh()
	Settings.set("perf.lowProfile", true)
	local n = 0
	Perf.every("l", 20, function() n += 1 end)
	for _ = 1, 60 do Perf.frame(1 / 60) end
	T.truthy(n >= 9 and n <= 11, "ran " .. n)
end)
T.test("LowChanged event", "fires on toggle", function()
	T.fresh()
	local events = {}
	Perf.LowChanged:Connect(function(v) table.insert(events, v) end)
	Perf.frame(0.016); Settings.set("perf.lowProfile", true); Perf.frame(0.016)
	T.eq(events[#events], true)
end)
T.test("failing task disabled after 5 errors", "isolated, event raised", function()
	T.fresh()
	local failed
	Perf.TaskFailed:Connect(function(name) failed = name end)
	local good = 0
	Perf.every("bad", 60, function() error("x") end)
	Perf.every("good", 60, function() good += 1 end)
	for _ = 1, 20 do Perf.frame(1 / 60) end
	T.eq(failed, "bad"); T.truthy(good >= 19)
	T.truthy(Perf.timings()[1] ~= nil)
	T.truthy(Perf.reenable("bad"))
end)
T.test("long operation warning", "task above warnMs logged", function()
	T.fresh()
	local t = 0
	Perf.setClock(function() t += 0.02; return t end) -- every clock() call advances 20 ms
	Perf.every("slow", 60, function() end)
	Perf.frame(1 / 30)
	T.eq(#Perf.longOps(), 1); T.eq(Perf.longOps()[1].name, "slow")
end)
T.test("auto low profile", "engages after 5 s under threshold, releases after recovery", function()
	T.fresh()
	Settings.set("perf.autoLow", true)
	for _ = 1, 400 do Perf.frame(1 / 10) end
	T.truthy(Perf.isLow())
	for _ = 1, 400 do Perf.frame(1 / 120) end
	T.falsy(Perf.isLow())
end)
T.test("fps estimate", "converges to frame rate", function()
	T.fresh()
	for _ = 1, 300 do Perf.frame(1 / 45) end
	T.truthy(math.abs(Perf.fps() - 45) < 1, tostring(Perf.fps()))
end)
T.test("cancel", "task stops", function()
	T.fresh()
	local n = 0
	local h = Perf.every("c", 60, function() n += 1 end)
	Perf.frame(1 / 30); h.Cancel(); Perf.frame(1 / 30)
	T.eq(n, 1); T.eq(Perf.taskCount(), 0)
end)
T.test("duplicate task name refused", "assert", function()
	T.fresh()
	Perf.every("d", 1, function() end)
	T.throws(function() Perf.every("d", 1, function() end) end, "duplicate")
end)
T.test("ping source", "returns number or nil", function()
	T.fresh()
	T.eq(Perf.ping(), nil)
	Perf.setSources({ ping = function() return 42 end }); T.eq(Perf.ping(), 42)
	Perf.setSources({ ping = function() error("x") end }); T.eq(Perf.ping(), nil)
end)

T.suite("Core")
T.test("dependency order", "deps start first", function()
	T.fresh()
	local order = {}
	local function mod(name, deps) Core.registerModule({ name = name, deps = deps, start = function() table.insert(order, name) end }) end
	mod("c", { "b" }); mod("b", { "a" }); mod("a", {})
	local rep = Core.startAll()
	T.deepEq(order, { "a", "b", "c" }); T.eq(#rep.started, 3)
end)
T.test("failure isolated, dependents blocked", "other modules unaffected", function()
	T.fresh()
	Core.registerModule({ name = "bad", start = function() error("kaboom") end })
	Core.registerModule({ name = "child", deps = { "bad" }, start = function() end })
	Core.registerModule({ name = "free", start = function() end })
	local rep = Core.startAll()
	T.deepEq(rep.failed, { "bad" }); T.deepEq(rep.blocked, { "child" }); T.deepEq(rep.started, { "free" })
	T.eq(Core.moduleState("bad"), "failed")
end)
T.test("restart recovers", "module runs after fix", function()
	T.fresh()
	local ok = false
	Core.registerModule({ name = "flaky", start = function() if not ok then error("not yet") end end })
	Core.startAll(); T.eq(Core.moduleState("flaky"), "failed")
	ok = true
	T.truthy(Core.restart("flaky")); T.eq(Core.moduleState("flaky"), "running")
end)
T.test("stop in reverse order and clean maid", "resources released", function()
	T.fresh()
	local order, released = {}, 0
	Core.registerModule({ name = "a", start = function(ctx) ctx.maid:Give(function() released += 1 end) end, stop = function() table.insert(order, "a") end })
	Core.registerModule({ name = "b", deps = { "a" }, start = function(ctx) ctx.maid:Give(function() released += 1 end) end, stop = function() table.insert(order, "b") end })
	Core.startAll()
	local rep = Core.stopAll()
	T.deepEq(order, { "b", "a" }); T.eq(released, 2); T.eq(rep.errors, 0); T.eq(Core.moduleState("a"), "stopped")
end)
T.test("stop error contained", "later modules still stop", function()
	T.fresh()
	local stopped = false
	Core.registerModule({ name = "a", start = function() end, stop = function() stopped = true end })
	Core.registerModule({ name = "b", deps = { "a" }, start = function() end, stop = function() error("x") end })
	Core.startAll()
	local rep = Core.stopAll()
	T.truthy(stopped); T.eq(rep.errors, 1)
end)
T.test("dependency check", "missing dep, cycle, missing env", function()
	T.fresh()
	Core.registerModule({ name = "x", deps = { "ghost" }, optionalEnv = { "gethui" }, start = function() end })
	Core.registerModule({ name = "p", deps = { "q" }, start = function() end })
	Core.registerModule({ name = "q", deps = { "p" }, start = function() end })
	local kinds = {}
	for _, pr in ipairs(Core.checkDependencies()) do kinds[pr.kind] = true end
	T.truthy(kinds["missing-module"] and kinds["cycle"] and kinds["missing-env"])
	local rep = Core.startAll()
	T.eq(#rep.blocked, 3)
end)
T.test("re-init detection", "previous instance shut down once", function()
	T.fresh()
	local g = Env.global(); g.__MM2HUB_TEST = nil
	local shut = 0
	local h1 = Core.boot({ globalKey = "__MM2HUB_TEST", shutdown = function() shut += 1 end })
	T.falsy(h1.replaced)
	local h2 = Core.boot({ globalKey = "__MM2HUB_TEST", shutdown = function() end })
	T.truthy(h2.replaced); T.eq(shut, 1)
	Core.release("__MM2HUB_TEST"); T.eq(g.__MM2HUB_TEST, nil)
end)
T.test("module state events", "StateChanged fires", function()
	T.fresh()
	local states = {}
	Core.StateChanged:Connect(function(n, s) table.insert(states, s) end)
	Core.registerModule({ name = "m", start = function() end })
	Core.startAll(); Core.stopAll()
	T.deepEq(states, { "running", "stopped" })
end)

T.suite("Cleanup")
T.test("steps run newest first with isolation", "all steps attempted", function()
	local order = {}
	Cleanup.register("one", function() table.insert(order, 1) end)
	Cleanup.register("bad", function() error("x") end)
	Cleanup.register("three", function() table.insert(order, 3) end)
	local rep = Cleanup.run()
	T.deepEq(order, { 3, 1 }); T.eq(#rep.failed, 1); T.eq(Cleanup.pending(), 0)
end)

T.suite("Diagnostics")
T.test("report contains sections", "version, env, providers, log", function()
	T.fresh()
	Diagnostics.addProvider("Custom", function() return { "line a", "line b" } end)
	Diagnostics.addProvider("Broken", function() error("nope") end)
	Logger.error("test", "visible error")
	local r = Diagnostics.report()
	for _, needle in ipairs({ "diagnostic report", "environment capabilities", "Custom", "line b", "provider failed", "visible error" }) do
		T.truthy(string.find(r, needle, 1, true), needle)
	end
	Diagnostics.removeProvider("Custom"); Diagnostics.removeProvider("Broken")
end)
T.test("export works without file API", "memory + reports result", function()
	T.fresh()
	local ok, msg = Diagnostics.export()
	T.truthy(ok, msg); T.truthy(Env.exists("MM2Hub/report.txt"))
end)
T.test("safeCall", "returns error, logs with label", function()
	T.fresh()
	local ok, err = Diagnostics.safeCall("thing", function() error("bad") end)
	T.falsy(ok); T.truthy(string.find(err, "bad")); T.eq(Logger.count("error"), 1)
	local ok2, v = Diagnostics.safeCall("fine", function(x) return x * 2 end, 4)
	T.truthy(ok2); T.eq(v, 8)
end)

T.suite("I18n")
T.test("fallback chain", "ru -> en -> key", function()
	I18n.set("ru"); T.eq(I18n.t("nav.camera"), "Камера")
	T.eq(I18n.t("totally.missing"), "totally.missing")
	I18n.set("en"); T.eq(I18n.t("nav.camera"), "Camera")
end)
T.test("format args", "string.format applied", function()
	T.eq(I18n.t("notify.loaded", "X"), "Profile 'X' loaded.")
end)
T.test("unknown language refused", "false", function()
	T.falsy((I18n.set("xx")))
end)
T.test("ru covers all en keys", "no untranslated keys", function()
	local missing = I18n.untranslated("ru")
	T.eq(#missing, 0, table.concat(missing, ","))
end)
